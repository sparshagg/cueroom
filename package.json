{
  "name": "cueroom",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, non-affiliated co-watch companion with video calls, chat, and Netflix playback sync.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm dev:prepare && turbo dev",
    "dev:prepare": "pnpm --filter @cueroom/shared build && pnpm --filter @cueroom/security build && pnpm --filter @cueroom/ui build",
    "build": "turbo build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "visual:test": "playwright test",
    "visual:check": "pnpm build && pnpm visual:test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "security:extension": "pnpm --filter @cueroom/security build && node scripts/audit-extension.mjs",
    "security:audit": "pnpm audit",
    "security:licenses": "node scripts/check-licenses.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:supply-chain": "pnpm security:secrets && pnpm security:licenses && pnpm security:audit",
    "dast:authenticated-flows": "node scripts/dast-authenticated-flows.mjs",
    "dast:export-zap-evidence": "node scripts/export-zap-evidence.mjs",
    "dast:check-zap-evidence": "node scripts/check-zap-evidence.mjs",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "store:check-package": "node scripts/check-store-package.mjs",
    "extension:package": "node scripts/package-extension.mjs",
    "release:check": "node scripts/check-release-readiness.mjs",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "docker:prod-check": "node scripts/check-production-docker.mjs",
    "cleanup:check": "node scripts/cleanup-check.mjs",
    "docs:freshness": "node scripts/check-docs-freshness.mjs",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm visual:test && pnpm security:extension && pnpm cleanup:check && pnpm docker:prod-check && pnpm docs:freshness"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "1.60.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "knip": "^5.55.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
