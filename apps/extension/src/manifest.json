{
  "manifest_version": 3,
  "name": "CueRoom",
  "description": "Private co-watch companion extension for local playback sync. Not affiliated with Netflix.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "CueRoom",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.netflix.com/watch/*"],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/watch/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "https://cueroom.app/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"
  }
}
